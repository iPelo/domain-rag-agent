# Copy this file to .env and fill in values. Each line maps to a field in
# backend/app/config.py (same name, uppercased). A blank value is treated as
# "unset".
APP_ENV=local
DOMAIN_NAME=GermanLawRAG

API_HOST=0.0.0.0
API_PORT=8000

# Where the vector store lives; the collection name groups this project's vectors.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=german_law_chunks

DATA_RAW_DIR=data/raw/german-laws
DATA_PROCESSED_DIR=data/processed
INDEX_CHUNKS_PATH=data/processed/chunks.curated.jsonl

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=30

# Chat-model settings for /answer only. Leave MODEL_* blank
# and /retrieve still works; just key/name/base-url are needed
# to enable /answer. Temperature 0 keeps answers stable.
MODEL_PROVIDER=hosted
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=800
MODEL_TIMEOUT_SECONDS=60
