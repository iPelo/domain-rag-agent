# Application
APP_ENV=local
DOMAIN_NAME=GermanLawRAG


# Retrieval
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=german_law_chunks

DATA_PROCESSED_DIR=data/processed
INDEX_CHUNKS_PATH=data/processed/chunks.curated.jsonl

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

RETRIEVAL_CANDIDATE_POOL=30

# Optional answer model
MODEL_PROVIDER=hosted
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=800
MODEL_TIMEOUT_SECONDS=60
